# ── 파이썬 ──────────────────────────────────────────────
__pycache__/
*.py[cod]
/venv
/.venv
.venv/

# ── 시크릿 ─────────────────────────────────────────────
# 이 저장소는 Public 이다. API 키가 절대 커밋되지 않게 한다.
.env
*.env
!.env.example
*.key
*.pem

# ── 실행 산출물 ────────────────────────────────────────
*.log
app/generated/

# Docker 빌드 때 CDN 에서 받아 넣는다 (Dockerfile 참고)
app/frontend/vendor/

# LEAN 백테스트 실행 결과. 실행할 때마다 타임스탬프 파일이 쌓이고
# `docker compose -f docker-compose.lean.yml run --rm samsung-backtest` 로 언제든 다시 만든다.
lean-results/
lean-results-old/

# 현대차 예측 백테스트 산출물(시세 CSV · 신호 CSV · LEAN 결과 · report.html).
# `docker compose -f docker-compose.hd.yaml run --rm hd-backtest` 로 언제든 다시 만든다.
lean-hyundai-results/

# LEAN CLI 워크스페이스(lean.json · data/ · 프로젝트). data/ 만 226MB 라 커밋하지 않는다.
lean-cli/

# ── 데이터 원본 ────────────────────────────────────────
# 교재·강의자료·데이터 원본은 커밋하지 않는다 (AGENTS.md 규칙).
# 앞의 `/` 는 저장소 루트만 가리킨다. 이게 없으면 app/frontend/js/data/ 처럼
# 코드가 쓰는 하위 폴더까지 함께 제외된다.
/DATA-ROOT/
/data/*
# `data/exports/` 만 예외다 — 폴더 자체는 추적하고 **내용물은 계속 무시**한다.
# `/data/` 로 폴더째 무시하면 `.gitkeep` 까지 걸려(`git check-ignore` 실측 2026-08-16)
# 클론한 사람에게 폴더가 없고, 익스포트가 첫 실행에서 실패한다.
# git 은 제외된 디렉터리 안으로 내려가지 않으므로 `/data/*` → `!폴더` → `폴더/*` →
# `!.gitkeep` 4줄이 전부 필요하다. `!/data/exports/.gitkeep` 한 줄만으로는 안 된다.
# (익스포트 산출물은 `api-contract.md` §5 대로 CSV·parquet 이고 아래 확장자 규칙에도 걸린다)
!/data/exports/
/data/exports/*
!/data/exports/.gitkeep
*.csv
*.xlsx
*.zip
*.pdf

# ── 프로젝트 문서 (Obsidian Vault 와 미러링) ───────────
/docs-spec/

# ── 에디터·OS ──────────────────────────────────────────
.claude/
.DS_Store
Thumbs.db
play**/
