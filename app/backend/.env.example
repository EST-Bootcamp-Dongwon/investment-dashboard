# 로컬에서 `uvicorn app.backend.main:app --reload`로 실행할 때 사용하는 예시입니다.
# Docker Compose 환경에서는 저장소 루트의 .env 값을 사용합니다.

# 문서 검색(RAG)용 Qdrant. 검색을 쓰지 않으면 없어도 다른 화면은 동작합니다.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=investment_docs

# ※ RAG_LLM_BASE_URL·RAG_LLM_API_KEY·RAG_LLM_MODEL 은 2026-08-16 에 없앴습니다.
#    외부 AI 로 답변을 다듬는 기능을 폐기했기 때문입니다 — 이 프로젝트의 절대 제약 1이
#    "LLM 유료 API 비용 0원" 입니다. RAG 답변은 검색된 원문만 조립해 만듭니다
#    (services/rag.compose_answer). 다시 넣지 마세요.

# OpenDART 기업·재무 공시 조회용 인증키 (미설정 시 DART API는 503을 반환)
DART_API_KEY=

# 추천 이력 저장·조회(F03)용 Supabase. 둘 다 없으면 /api/recommendation/preview 는
# 그대로 동작하고 create·history·detail 만 503이 됩니다.
#
# ★ SUPABASE_SERVICE_ROLE_KEY 는 서버 전용입니다. 프론트에 내려가면 RLS 가 전부
#   무력화되어 모든 사용자의 이력이 열립니다. 브라우저로 보내지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 선택 사항: GPU가 있는 환경에서 텍스트-이미지 생성 모델을 바꿀 때만 설정합니다.
# DIFFUSERS_MODEL_ID=runwayml/stable-diffusion-v1-5
